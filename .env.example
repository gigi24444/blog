# Claude API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 배포될 사이트의 실제 URL (sitemap/RSS/canonical 태그에 사용)
SITE_URL=https://example.com

# --- SNS/외부 채널 자동 배포 (scripts/distribute.mjs) ---
# 설정하지 않으면 해당 채널은 자동으로 건너뜁니다.
DISCORD_WEBHOOK_URL=

# --- Google AdSense ---
# AdSense 승인 전에는 비워두세요. 광고 자리에는 자동으로 자리표시자가 표시됩니다.
# 발급받은 값 예시: PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
PUBLIC_ADSENSE_CLIENT=
# 광고 관리 페이지에서 만든 광고 단위(슬롯)별 ID
PUBLIC_ADSENSE_SLOT_BANNER=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
