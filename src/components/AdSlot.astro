---
// AdSense 광고 단위 하나를 렌더링합니다.
// PUBLIC_ADSENSE_CLIENT 또는 slot이 없으면 광고 대신 자리표시자 박스를 보여줍니다.
interface Props {
  slot?: string;
  format?: string;
  layout?: string;
  class?: string;
}

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const { slot, format = "auto", layout, class: className = "" } = Astro.props;
const ready = Boolean(client && slot);
---

{ready ? (
  <>
    <ins
      class={`adsbygoogle ${className}`}
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-ad-layout={layout}
      data-full-width-responsive="true"
    />
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </>
) : (
  <div class={`ad-placeholder ${className}`}>광고 영역 (AdSense 설정 필요)</div>
)}

<style>
  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 90px;
    border: 1px dashed var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    border-radius: 8px;
  }
</style>
