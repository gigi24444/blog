---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { href, title, description, pubDate, tags } = Astro.props;
const formatted = pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a class="post-card" href={href}>
  <time datetime={pubDate.toISOString()}>{formatted}</time>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map((tag) => <span>#{tag}</span>)}
    </div>
  )}
</a>

<style>
  .post-card {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow);
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    text-decoration: none;
  }
  .post-card time {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .post-card h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.15rem;
  }
  .post-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .post-card-tags {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-card-tags span {
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
</style>
