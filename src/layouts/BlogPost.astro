---
import BaseHead from "../components/BaseHead.astro";
import AdSlot from "../components/AdSlot.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
const formatted = (d: Date) =>
  d.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <div class="layout">
        <article class="prose">
          <p class="meta">
            <time datetime={pubDate.toISOString()}>{formatted(pubDate)}</time>
            {updatedDate && <> · 수정: <time datetime={updatedDate.toISOString()}>{formatted(updatedDate)}</time></>}
          </p>
          <h1>{title}</h1>
          {tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          )}
          <hr />
          <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_IN_ARTICLE} layout="in-article" format="fluid" class="in-article" />
          <slot />
          <p class="back-link"><a href="/blog">← 목록으로</a></p>
        </article>
        <Sidebar />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
  }
  .layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  article {
    flex: 1;
    min-width: 0;
  }
  .meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.75rem;
  }
  .in-article {
    margin: 1.5rem 0;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .tag {
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .back-link {
    margin-top: 2.5rem;
  }
  @media (max-width: 860px) {
    .layout {
      flex-direction: column;
    }
  }
</style>
